
pipeline {

    parameters {
        choice(
            name: 'terraformAction',
            choices: ['apply', 'destroy'],
            description: 'Choose the terraform action to perform'
        )
    }

    environment {
        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }

    agent any

    stages {

        stage('Checkout') {
            steps {
                script {
                    dir("Terraform") {
                        git branch: 'main',
                            url: 'https://github.com/muniraj-git/Terraform.git'
                    }
                }
            }
        }

        stage('Plan') {
            steps {
                dir('Terraform/07-Project-01') {
                    sh 'terraform init'

                    script {
                        if (params.terraformAction == 'apply') {
                            sh 'terraform plan -out=tfplan'
                        } else {
                            sh 'terraform plan -destroy -out=tfplan'
                        }
                    }

                    sh 'terraform show -no-color tfplan > plan.txt'
                }
            }
        }

        stage('Approval') {
            steps {
                script {
                    def plan = readFile 'Terraform/07-Project-01/plan.txt'

                    input(
                        message: "Review Terraform plan before proceeding:\n\n${plan}",
                        ok: 'Approve and proceed'
                    )
                }
            }
        }

        stage('Apply or Destroy') {
            steps {
                dir('Terraform/07-Project-01') {
                    sh 'terraform apply -input=false tfplan'
                }
            }
        }

    }
}
