pipeline{
    
    parameters{
      choice(name: 'terraformAction', choices: ['apply', 'destroy'], description: 'Choose the terraform action to perform')
    }

    environment {

        AWS_ACCESS_KEY_ID = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
    }

    agent any

    stages{
        stage('checkout'){
            steps{
                script {
                    dir("Terraform") {
                        git branch: 'main' , url: 'https://github.com/muniraj-git/Terraform.git'
                    }
                }
            }
        }

        stage('plan'){
            steps{
                // Navigate into the checkked-out directory and then into the Project-01 subdirectory
                sh 'cd Terraform/07-Project-01; terraform init'
                sh 'cd Terraform/07-Project-01; terraform plan -out=tfplan'
                sh 'cd Terraform/07-Project-01; terraform show -no-color tfplan >> ../tfplan.txt'  // Write plan to parent dir for easier access
            }
        }

        stage('approval'){
            steps{
                script {
                    // Read the plan file from the workspace root or the checked out directory (using the tfplan.txt file created in the previous stage)
                    def plan = readFile 'Terraform/tfplan.txt'

                    input(
                        message: "Do you want to proceed with the Terraform action",
                        parameters: [
                            text(name: 'planReview', description: 'Can you review your code one more time', defaultValue: plan)
                        ]
                    )
                }
            }
        }

        stage ('apply or destroy') {
            when {
                expression {
                    return params.terraformAction == 'apply' || params.terraformAction == 'destroy'
                }
            }
            steps{
                script{
                    if (params.terraformAction == 'apply') {

                        sh "cd Terraform/07-Project-01; terraform apply -input=false tfplan"
                    } else if (params.terraformAction == 'destroy'){

                        sh "cd iac-repo/07-Project-01; terraform destroy -auto-approve" 
                        
                    }
                    }
                }
            }

    }


}